# 复制为 .env 后填入真实值(.env 不提交)
# ==================== PostgreSQL ====================
# 云端 PG(与 CoCoWork/DaisyWind 同一实例,仅库名不同)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=fital

# ==================== LLM(任意 OpenAI 兼容端点)====================
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# 端点私有参数(JSON,可空)。DeepSeek 需关思考模式才能用结构化输出:
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
