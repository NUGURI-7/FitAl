# 复制为 .env 后填入真实值(.env 不提交)
# ==================== PostgreSQL ====================
# 云端 PG(与 CoCoWork/DaisyWind 同一实例,仅库名不同)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=fital

# ==================== LLM(任意 OpenAI 兼容端点)====================
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# 端点私有参数(JSON,可空)。DeepSeek 需关思考模式才能用结构化输出:
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ==================== 豆包流式语音识别(火山引擎 ASR,新版 API Key 接入)====================
# 新版控制台"API Keys"页获取的 API Key(密钥,填自己的,勿提交);只此一项必填
DOUBAO_ASR_API_KEY=
# 资源 ID:豆包流式语音识别 2.0 小时版(一般不用改)
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 接入地址:双向流式优化版(一般不用改)
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
